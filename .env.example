# ── Backend ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://tcerp:tcerp@localhost:5433/tcerp?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO (file storage) ────────────────────────────
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=tcerpminio
S3_SECRET_KEY=tcerpminio123
S3_BUCKET=tcerp-files
S3_FORCE_PATH_STYLE=true

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
