# NOTE: this root-level sample is a convenience snapshot. The AUTHORITATIVE
# backend sample is apps/backend/.env.example (run-local.bat copies that one
# for fresh installs). Do not put operational fixed passwords here.

# ── Backend ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://tcerp:tcerp@localhost:5433/tcerp?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed admin (prisma/seed.ts reads SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD).
# The AUTHORITATIVE sample file is apps/backend/.env.example — run-local.bat
# copies THAT file for fresh installs and replaces the password below with a
# RANDOM value. The placeholder is dev-only: production boot REFUSES it
# (seed.ts rejects well-known defaults in production).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO (file storage) ────────────────────────────
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=tcerpminio
S3_SECRET_KEY=tcerpminio123
S3_BUCKET=tcerp-files
S3_FORCE_PATH_STYLE=true

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
