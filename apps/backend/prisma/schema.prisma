// TCERP — schema after Architecture Correction Gate (2026-10-06).
// Corrections applied vs. previous revision:
//  * Multi-company readiness from day one (Company, UserCompany, company scoping).
//  * No standalone BankTransaction source of truth — treasury sources are
//    Receipt / Payment / BankTransfer / Check clearing / Bank Adjustment;
//    BankStatementLine is a non-source ledger for ordering/running balance.
//  * OperationalSettlementClaim (direction-aware) replaces sale-only claim.
//  * Explicit SalesTaxInvoiceOrderAllocation / PurchaseTaxInvoiceOrderAllocation
//    (no generic polymorphic allocation table).
//  * Loading is header + LoadingLine + LoadingAllocation.
//  * SupplierProduct mapping is genuinely three-level with a CHECK.
//  * WorkflowTimer runtime entity (owner: Workflow engine, executor: queue).
//  * NotificationRule gained company scope + conditions.
//  * Queue: BullMQ/Redis = runtime, QueueJob/JobExecution = durable history.
//  * Sequence engine: company scope + reset_cycle + concurrency-safe allocation.
//  * TaxDefinition: company scoped, immutable after first use, snapshot on lines.
//
// Bare Uuid columns marked "Phase N FK" reference tables that land with their own
// phase (Party/Product/Sales/Purchase). FK constraints are added by those phases'
// migrations — the columns exist now so corrected relations never need renumbering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Company ─────────────────────────────

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  nameFa       String        @map("name_fa")
  nameEn       String?       @map("name_en")
  nationalId   String?       @map("national_id")
  economicCode String?       @map("economic_code")
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users              UserCompany[]
  companyRoles       UserCompanyRole[]
  teams              Team[]
  settings           Setting[]
  sequences          Sequence[]
  integrationConfigs IntegrationConfig[]
  notificationRules  NotificationRule[]
  notifications      Notification[]
  queueJobs          QueueJob[]
  bankAccounts       BankAccount[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
  receipts           Receipt[]
  payments           Payment[]
  bankTransfers      BankTransfer[]
  checks             Check[]
  taxDefinitions     TaxDefinition[]
  claims             OperationalSettlementClaim[]
  loadings           Loading[]
  workflowDefinitions WorkflowDefinition[]
  portalAccounts     PortalAccount[]
  defaultUsers       User[]
  userRoleOverrides  UserPermissionOverride[]
  fileAttachments    FileAttachment[]
  parties            Party[]
  timelineEvents     TimelineEvent[]
  productCategories  ProductCategory[]
  brands             Brand[]
  uomCategories      UomCategory[]
  uoms               Uom[]
  attributes         Attribute[]
  productTemplates   ProductTemplate[]
  productVariants    ProductVariant[]
  supplierProducts   SupplierProduct[]
  leads              Lead[]
  opportunities      Opportunity[]
  lostReasons        LostReason[]
  paymentTerms       PaymentTerm[]
  salesDocuments     SalesDocument[]
  purchaseDocuments  PurchaseDocument[]
  salesPurchaseAllocations SalesPurchaseAllocation[]
  priceRequests      PriceRequest[]
  supplierOffers     SupplierOffer[]
  documentRelations  DocumentRelation[]
  dailyPrices        DailyPrice[]
  publishBatches     PublishBatch[]
  publishingTemplates PublishingTemplate[]
  automationRules    AutomationRule[]
  warehouses         Warehouse[]
  stockLocations     StockLocation[]
  stockMovements     StockMovement[]
  approvalRequests   ApprovalRequest[]

  @@map("companies")
}

// ────────────────────────────── CRM: Party ──────────────────────────────
// Party is the single central CRM entity: a PERSON or COMPANY that can hold
// several roles at once (CUSTOMER + SUPPLIER + DRIVER + ...). Always
// company-scoped. FKs from Sales/Purchase/Loading land in Phase 4/6.

enum PartyType {
  PERSON
  COMPANY
}

enum PartyRoleType {
  CUSTOMER
  SUPPLIER
  DRIVER
  CARRIER
  PARTNER
}

enum PhoneKind {
  MOBILE
  PHONE
  FAX
  WHATSAPP
}

model Party {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  type          PartyType
  nameFa        String    @map("name_fa")
  nameEn        String?   @map("name_en")
  internalCode  String?   @map("internal_code")

  // COMPANY fields
  registrationNumber String? @map("registration_number")
  nationalId         String? @map("national_id")
  economicCode       String? @map("economic_code")
  postalCode         String? @map("postal_code")
  website            String?
  email              String?

  // PERSON fields
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  gender        String?
  birthDate     DateTime? @map("birth_date") @db.Date
  nationalCode  String?   @map("national_code")

  // CRM ownership: Party owner (assigned salesperson). Independent from any
  // future sales-document salesperson (REQUIREMENTS §4).
  ownerUserId   String?   @map("owner_user_id") @db.Uuid
  notes         String?

  // Cached customer score (see CustomerScoreHistory); computed, not hand-edited.
  score         Int?
  scoreLevel    ScoreLevel? @map("score_level")

  version       Int       @default(1) // optimistic locking
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy    String?   @map("archived_by") @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company                 @relation(fields: [companyId], references: [id])
  owner      User?                   @relation("PartyOwner", fields: [ownerUserId], references: [id])
  roles      PartyRole[]
  phones     PartyPhone[]
  contacts   Contact[]
  addresses  Address[]
  scores     CustomerScoreHistory[]
  responsibleFor    FinancialResponsibility[] @relation("ResponsibleParty")
  membershipOf      FinancialResponsibility[] @relation("MemberParty")
  supplierMappings  SupplierProduct[]
  leads             Lead[]
  opportunityCustomers Opportunity[] @relation("OpportunityCustomer")
  salesDocuments    SalesDocument[] @relation("SalesCustomer")
  purchaseDocuments PurchaseDocument[] @relation("PurchaseSupplier")
  priceRequests     PriceRequest[] @relation("PriceRequestCustomer")
  supplierOffers    SupplierOffer[] @relation("OfferSupplier")
  pricedAsSupplier  DailyPrice[] @relation("PricedAsSupplier")
  loadingAsCustomer Loading[]    @relation("LoadingCustomer")
  loadingAsDriver   Loading[]    @relation("LoadingDriver")
  loadingAsCarrier  Loading[]    @relation("LoadingCarrier")
  stockLocations    StockLocation[] @relation("LocationParty")

  @@unique([companyId, internalCode])
  @@unique([companyId, nationalId])
  @@unique([companyId, nationalCode])
  @@index([companyId, nameFa])
  @@index([companyId, type, archivedAt])
  @@index([companyId, ownerUserId])
  @@map("parties")
}

// One Party may hold several roles simultaneously (unique per pair).
model PartyRole {
  id       String        @id @default(uuid()) @db.Uuid
  partyId  String        @map("party_id") @db.Uuid
  role     PartyRoleType
  since    DateTime      @default(now()) @db.Timestamptz(6)
  notes    String?

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, role])
  @@map("party_roles")
}

// Multi-phone model with a normalized canonical value. Exact duplicate
// normalized MOBILE within a company is blocked by a partial unique index
// (parties_mobile_uniq, added in migration); landlines may repeat.
model PartyPhone {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  partyId         String    @map("party_id") @db.Uuid
  kind            PhoneKind @default(MOBILE)
  rawValue        String    @map("raw_value")
  normalizedValue String    @map("normalized_value")
  isPrimary       Boolean   @default(false) @map("is_primary")
  extension       String?
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([companyId, normalizedValue])
  @@map("party_phones")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  partyId   String   @map("party_id") @db.Uuid
  name      String
  position  String?
  email     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  party  Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  phones ContactPhone[]

  @@index([partyId])
  @@map("contacts")
}

model ContactPhone {
  id              String    @id @default(uuid()) @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  kind            PhoneKind @default(MOBILE)
  rawValue        String    @map("raw_value")
  normalizedValue String    @map("normalized_value")
  isPrimary       Boolean   @default(false) @map("is_primary")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_phones")
}

enum AddressType {
  MAIN
  BILLING
  SHIPPING
  UNLOADING
  OFFICE
  WAREHOUSE
  OTHER
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  partyId    String      @map("party_id") @db.Uuid
  type       AddressType @default(MAIN)
  country    String      @default("ایران")
  province   String?
  city       String?
  postalCode String?     @map("postal_code")
  line       String
  isPrimary  Boolean     @default(false) @map("is_primary")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  salesShipping SalesDocument[]

  @@index([partyId])
  @@map("addresses")
}

enum ScoreLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  VIP
}

// Append-only score computation history. Weights/thresholds live in company
// Settings (crm.score_rules), never hard-coded (REQUIREMENTS §4).
model CustomerScoreHistory {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  partyId        String     @map("party_id") @db.Uuid
  score          Int
  level          ScoreLevel
  metrics        Json // { operationalProfit, tonnage, purchaseCount, paidAmount, recencyDays, frequency }
  computedAt     DateTime   @map("computed_at") @db.Timestamptz(6)
  computedBy     String?    @map("computed_by") @db.Uuid
  note           String?

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, computedAt])
  @@map("customer_score_history")
}

// A financially responsible party answers for several member parties without
// merging their identities (REQUIREMENTS §38/§100). A member belongs to at
// most one group per company.
model FinancialResponsibility {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  responsiblePartyId  String   @map("responsible_party_id") @db.Uuid
  memberPartyId       String   @map("member_party_id") @db.Uuid
  note                String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  responsibleParty Party @relation("ResponsibleParty", fields: [responsiblePartyId], references: [id], onDelete: Cascade)
  memberParty      Party @relation("MemberParty", fields: [memberPartyId], references: [id], onDelete: Cascade)

  @@unique([companyId, responsiblePartyId, memberPartyId])
  @@unique([companyId, memberPartyId])
  @@index([companyId, responsiblePartyId])
  @@map("financial_responsibilities")
}

// Generic timeline foundation (CRM now; every important entity later).
// Noise control: `visible` lets managers hide event types from the shared view.
model TimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  type        String // PARTY_CREATED | ROLE_ADDED | PHONE_ADDED | OWNER_CHANGED | CALL | ...
  title       String
  description String?
  data        Json?
  actorType   String   @default("USER") @map("actor_type") // USER | SYSTEM
  actorUserId String?  @map("actor_user_id") @db.Uuid
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([companyId, createdAt])
  @@map("timeline_events")
}

// ───────────────────────── Identity & Access ─────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique
  email              String?    @unique
  passwordHash       String     @map("password_hash")
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  mobile             String?
  status             UserStatus @default(ACTIVE)
  language           String     @default("fa")
  timezone           String     @default("Asia/Tehran")
  defaultCompanyId   String?    @map("default_company_id") @db.Uuid
  version            Int        @default(1) // optimistic locking
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid

  defaultCompany  Company?                 @relation(fields: [defaultCompanyId], references: [id])
  companies       UserCompany[]
  companyRoles    UserCompanyRole[]
  overrides       UserPermissionOverride[]
  refreshTokens   RefreshToken[]
  teamMemberships TeamMember[]
  ownedParties    Party[] @relation("PartyOwner")
  leadsAssigned   Lead[] @relation("LeadSalesperson")
  opportunities   Opportunity[] @relation("OpportunitySalesperson")
  salesDocuments  SalesDocument[] @relation("SalesSalesperson")
  purchaseDocuments PurchaseDocument[] @relation("PurchaseBuyer")
  priceRequests   PriceRequest[] @relation("PriceRequester")

  @@index([status])
  @@map("users")
}

// Membership of a user in a company. `User.defaultCompanyId` is the single
// canonical source for the default company — this table is membership only.
model UserCompany {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

// Company-scoped role assignment (Mini-Gate #1): the same user may be
// SALES_MANAGER in company A and SALESPERSON in company B. Role/Permission
// definitions remain system-level. @@id matches the ratified unique triple.
model UserCompanyRole {
  userId     String   @map("user_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  @@index([companyId, roleId])
  @@map("user_company_roles")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") // sha256 of the raw token
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Roles & permissions are system-level; company-specific role bindings are
// resolved through UserCompany + future role-scope columns (ERD §Identity).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameFa    String   @map("name_fa")
  nameEn    String   @map("name_en")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users           UserCompanyRole[]
  permissions     RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  module      String
  action      String
  description String?

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum OverrideMode {
  GRANT
  REVOKE
}

// Mini-Gate #1: companyId null = platform-wide override (applies in every
// company the user is a member of); non-null = company-specific override.
model UserPermissionOverride {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  permissionId String       @map("permission_id") @db.Uuid
  companyId    String?      @map("company_id") @db.Uuid
  mode         OverrideMode
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?      @map("created_by") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, companyId])
  @@map("user_permission_overrides")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  managerId String?  @map("manager_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company      @relation(fields: [companyId], references: [id])
  members TeamMember[]

  @@index([companyId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String? @map("company_id") @db.Uuid // null = platform-level event
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  action     String
  actorId    String? @map("actor_id") @db.Uuid
  actorName  String? @map("actor_name") // snapshot, survives user deletion
  oldValues  Json?   @map("old_values")
  newValues  Json?   @map("new_values")
  reason     String?
  ip         String?
  userAgent  String? @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([companyId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── Settings ───────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String
  value       Json
  category    String   @default("general")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@index([category])
  @@map("settings")
}

// ─────────────────────────── Sequences ───────────────────────────
// Company-scoped, concurrency-safe, cycle-resettable numbering.
// Existing documents are NEVER renumbered after a format change.

enum SequenceResetCycle {
  NEVER
  FISCAL_YEAR
  JALALI_YEAR
  MONTHLY
}

model Sequence {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  documentType    String             @map("document_type") // e.g. SALES_DOCUMENT
  name            String
  prefix          String
  padding         Int                @default(5)
  resetCycle      SequenceResetCycle @default(NEVER) @map("reset_cycle")
  currentNumber   Int                @default(0) @map("current_number")
  lastResetMarker String?            @map("last_reset_marker") // e.g. 1405 for JALALI_YEAR, 1405-07 for MONTHLY
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType])
  @@map("sequences")
}

// ───────────────────────────── Files ─────────────────────────────

model FileBlob {
  id         String   @id @default(uuid()) @db.Uuid
  sha256     String   @unique
  mimeType   String   @map("mime_type")
  size       BigInt
  storageKey String   @map("storage_key")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Filenames intentionally live on FileAttachment (per-upload metadata), never
  // on the deduped blob: two companies uploading identical bytes with different
  // names share one blob and neither name leaks to the other (Mini-Gate #8).
  attachments FileAttachment[]

  @@map("file_blobs")
}

model FileAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  fileBlobId       String   @map("file_blob_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  originalFilename String   @map("original_filename")
  displayName      String?  @map("display_name")
  category         String?
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fileBlob FileBlob @relation(fields: [fileBlobId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])
  brandLogos Brand[]

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([fileBlobId])
  @@map("file_attachments")
}

// ───────────────────────────── Queue ─────────────────────────────
// BullMQ/Redis owns runtime execution/scheduling/retry; QueueJob +
// JobExecution own durable business history, status and idempotency.

enum QueuePriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum QueueJobStatus {
  PENDING
  SCHEDULED
  PROCESSING
  RETRYING
  FAILED
  SUCCEEDED
  CANCELLED
}

model QueueJob {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String?        @map("company_id") @db.Uuid // null = platform-level job
  queueName      String         @default("default") @map("queue_name")
  jobType        String         @map("job_type")
  payload        Json
  priority       QueuePriority  @default(NORMAL)
  status         QueueJobStatus @default(PENDING)
  attemptCount   Int            @default(0) @map("attempt_count")
  maxAttempts    Int            @default(5) @map("max_attempts")
  scheduledAt    DateTime       @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(6)
  lastError      String?        @map("last_error")
  idempotencyKey String?        @map("idempotency_key") // unique per company (see @@unique); platform jobs (null) are deduped in service
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company?       @relation(fields: [companyId], references: [id])
  executions JobExecution[]

  @@index([status, priority, scheduledAt])
  @@index([jobType, status])
  @@unique([companyId, idempotencyKey])
  @@map("queue_jobs")
}

// Append-only per-attempt history (REQUIREMENTS §70/§71: history retained).
model JobExecution {
  id         String         @id @default(uuid()) @db.Uuid
  jobId      String         @map("job_id") @db.Uuid
  attemptNo  Int            @map("attempt_no")
  status     QueueJobStatus
  startedAt  DateTime       @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?      @map("finished_at") @db.Timestamptz(6)
  error      String?

  job QueueJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNo])
  @@map("job_executions")
}

// ──────────────────────── Integrations ────────────────────────

model IntegrationConfig {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  type      String // SMS | TELEGRAM | WHATSAPP | EITAA | BALE | RUBIKA | WEBSITE | MOADIAN | EMAIL
  isActive  Boolean  @default(false) @map("is_active")
  isPrimary Boolean  @default(false) @map("is_primary")
  config    Json // non-secret adapter settings; secrets stay in encrypted columns owned by the module
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([type])
  @@map("integration_configs")
}

// ─────────────────────── Notifications ───────────────────────

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  companyId         String?            @map("company_id") @db.Uuid // null = platform notification
  title             String
  body              String?
  relatedEntityType String?            @map("related_entity_type")
  relatedEntityId   String?            @map("related_entity_id")
  priority          QueuePriority      @default(NORMAL)
  status            NotificationStatus @default(UNREAD)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, companyId, status, createdAt])
  @@map("notifications")
}

model NotificationRule {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  code            String
  event           String // e.g. payment.rejected, quotation.followup
  conditions      Json? // e.g. {"all":[{"field":"claimDirection","equals":"CUSTOMER_RECEIPT"}]}
  recipientConfig Json          @map("recipient_config") // [{type: RECORD_OWNER|ROLE|USER, value}]
  channels        Json // [IN_APP, SMS]
  delayConfig     Json?         @map("delay_config") // {"delayMinutes":0,"jitter":...}
  priority        QueuePriority @default(NORMAL)
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([event, enabled])
  @@map("notification_rules")
}

// ─────────────────── Workflow (foundation for timers) ───────────────────

model WorkflowDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  entityType String  @map("entity_type") // SALES_DOCUMENT | PURCHASE | LOADING | ...
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company            @relation(fields: [companyId], references: [id])
  states    WorkflowState[]
  instances WorkflowInstance[]

  @@unique([companyId, code])
  @@map("workflow_definitions")
}

model WorkflowState {
  id           String @id @default(uuid()) @db.Uuid
  definitionId String @map("definition_id") @db.Uuid
  code         String
  name         String

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  instances  WorkflowInstance[]
  timers     WorkflowTimer[]

  @@unique([definitionId, code])
  @@map("workflow_states")
}

model WorkflowInstance {
  id             String   @id @default(uuid()) @db.Uuid
  definitionId   String   @map("definition_id") @db.Uuid
  currentStateId String?  @map("current_state_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  currentState WorkflowState?   @relation(fields: [currentStateId], references: [id])
  timers WorkflowTimer[]

  @@unique([definitionId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("workflow_instances")
}

model WorkflowTimer {
  id                 String       @id @default(uuid()) @db.Uuid
  workflowInstanceId String       @map("workflow_instance_id") @db.Uuid
  stateId            String       @map("state_id") @db.Uuid
  timerType          String       @map("timer_type") // ESCALATION | REMINDER | TIMEOUT
  dueAt              DateTime     @map("due_at") @db.Timestamptz(6)
  status             TimerStatus  @default(SCHEDULED)
  actionConfig       Json         @map("action_config")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  executedAt         DateTime?    @map("executed_at") @db.Timestamptz(6)

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  state    WorkflowState    @relation(fields: [stateId], references: [id])

  @@index([status, dueAt])
  @@map("workflow_timers")
}

enum TimerStatus {
  SCHEDULED
  EXECUTED
  CANCELLED
  FAILED
}

// ─────────────────────── Tax definitions ───────────────────────
// Company-scoped, append-only after first use: rate change = new row.
// Documents keep tax_rate_snapshot and never change retroactively.

model TaxDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String // e.g. VAT_9
  name      String // e.g. ارزش افزوده ۹٪
  rate      Decimal  @db.Decimal(9, 4) // percent, e.g. 9.0000
  isActive  Boolean  @default(true) @map("is_active")
  // Mini-Gate #4: set on first use in a tax invoice line; afterwards code/rate
  // are immutable — a rate change means a NEW TaxDefinition row.
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  templates ProductTemplate[]
  salesLines SalesLine[]

  @@unique([companyId, code])
  @@map("tax_definitions")
}

// ─────────────── Operational settlement claims ───────────────
// Salesperson-declared settlements; operational balance effect is temporary
// until the accountant matches it to a treasury document. Rejecting restores
// the operational balance and emits audit + timeline + notification.

enum ClaimDirection {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

enum ClaimStatus {
  UNMATCHED
  MATCHED
  REJECTED
}

model OperationalSettlementClaim {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  direction           ClaimDirection
  partyId             String        @map("party_id") @db.Uuid // Party FK lands in Phase 3
  salesDocumentId     String?       @map("sales_document_id") @db.Uuid // Phase 4 FK
  purchaseDocumentId  String?       @map("purchase_document_id") @db.Uuid // Phase 4 FK
  amount              Decimal       @db.Decimal(20, 4)
  currency            String        @default("IRR")
  status              ClaimStatus   @default(UNMATCHED)
  declaredAt          DateTime      @default(now()) @map("declared_at") @db.Timestamptz(6)
  declaredBy          String?       @map("declared_by") @db.Uuid
  matchedReceiptId    String?       @map("matched_receipt_id") @db.Uuid
  matchedPaymentId    String?       @map("matched_payment_id") @db.Uuid
  rejectionReason     String?       @map("rejection_reason")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([partyId, status])
  @@map("operational_settlement_claims")
}

// Cached operational (non-accounting) balance per party. UNMATCHED claims move
// it temporarily; REJECTED restores it. Phase 4/7 will keep this in sync with
// real order/invoice/receipt postings (optimistic version for concurrent edits).
model PartyOperationalBalance {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  partyId   String   @map("party_id") @db.Uuid // Party FK lands in Phase 3
  balance   Decimal  @default(0) @db.Decimal(20, 4) // positive = party owes the company
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, partyId])
  @@map("party_operational_balances")
}

// ─────────────── Tax invoice ↔ order allocations (M:N) ───────────────
// Two explicit tables; no generic polymorphic allocation.

model SalesTaxInvoiceOrderAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  salesTaxInvoiceId String  @map("sales_tax_invoice_id") @db.Uuid // Phase 8 FK
  salesDocumentId  String   @map("sales_document_id") @db.Uuid // Phase 4 FK
  allocatedAmount  Decimal  @map("allocated_amount") @db.Decimal(20, 4)
  allocatedQuantity Decimal? @map("allocated_quantity") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([salesTaxInvoiceId, salesDocumentId])
  @@index([salesDocumentId])
  @@map("sales_tax_invoice_order_allocations")
}

model PurchaseTaxInvoiceOrderAllocation {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  purchaseTaxInvoiceId String @map("purchase_tax_invoice_id") @db.Uuid // Phase 8 FK
  purchaseDocumentId String   @map("purchase_document_id") @db.Uuid // Phase 4 FK
  allocatedAmount    Decimal  @map("allocated_amount") @db.Decimal(20, 4)
  allocatedQuantity  Decimal? @map("allocated_quantity") @db.Decimal(18, 4)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([purchaseTaxInvoiceId, purchaseDocumentId])
  @@index([purchaseDocumentId])
  @@map("purchase_tax_invoice_order_allocations")
}

// ───────────────────────── Product Catalog (3B) ─────────────────────────
// Odoo-style: ProductTemplate (commercial family) + ProductVariant (SKU).
// Dynamic attributes define variants; nothing hard-coded. No stock quantity
// on templates — inventory is auto-movement (Phase 6).

enum ProductType {
  STORABLE
  CONSUMABLE
  SERVICE
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  nameFa      String   @map("name_fa")
  nameEn      String?  @map("name_en")
  code        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  company   Company           @relation(fields: [companyId], references: [id])
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  templates ProductTemplate[]
  supplierMappings SupplierProduct[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("product_categories")
}

model Brand {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  nameFa           String   @map("name_fa")
  nameEn           String?  @map("name_en")
  code             String
  logoAttachmentId String?  @map("logo_attachment_id") @db.Uuid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int      @default(1)

  company        Company         @relation(fields: [companyId], references: [id])
  logoAttachment FileAttachment? @relation(fields: [logoAttachmentId], references: [id])
  templates      ProductTemplate[]

  @@unique([companyId, code])
  @@index([companyId, nameFa])
  @@map("brands")
}

// UOM engine: conversions only inside the same category; Decimal ratios only.

model UomCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nameFa    String   @map("name_fa")
  nameEn    String?  @map("name_en")
  code      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  uoms    Uom[]

  @@unique([companyId, code])
  @@map("uom_categories")
}

model Uom {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  nameFa          String   @map("name_fa")
  nameEn          String?  @map("name_en")
  symbol          String
  conversionRatio Decimal  @map("conversion_ratio") @db.Decimal(20, 6) // vs base; > 0 (DB CHECK); base must be exactly 1
  isBaseUnit      Boolean  @default(false) @map("is_base_unit") // AT MOST one per category (partial unique); conversion blocked until one exists
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company           @relation(fields: [companyId], references: [id])
  category          UomCategory       @relation(fields: [categoryId], references: [id])
  salesTemplates    ProductTemplate[] @relation("TemplateSalesUom")
  purchaseTemplates ProductTemplate[] @relation("TemplatePurchaseUom")
  weightVariants    ProductVariant[]  @relation("VariantWeightUom")
  inventoryVariants ProductVariant[]  @relation("VariantInventoryUom")
  variants          ProductVariant[]
  movementSourceUoms    StockMovement[] @relation("MovementSourceUom")
  movementInventoryUoms StockMovement[] @relation("MovementInventoryUom")
  lineFulfillments      PurchaseLineFulfillment[]
  goodsReceiptLines GoodsReceiptLine[]
  salesLines        SalesLine[]
  purchaseLines     PurchaseLine[]
  priceRequestLines PriceRequestLine[]
  supplierOffers    SupplierOffer[]
  dailyPrices       DailyPrice[]

  @@unique([companyId, symbol])
  @@index([companyId, categoryId])
  @@map("uoms")
}

// Dynamic attributes (REQUIREMENTS §5): nothing hard-coded.

model Attribute {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  code         String
  nameFa       String   @map("name_fa")
  nameEn       String?  @map("name_en")
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company                    @relation(fields: [companyId], references: [id])
  values             AttributeValue[]
  templateAttributes ProductTemplateAttribute[]
  variantValues      VariantAttributeValue[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("attributes")
}

model AttributeValue {
  id           String   @id @default(uuid()) @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  valueFa      String   @map("value_fa")
  valueEn      String?  @map("value_en")
  code         String
  numericValue Decimal? @map("numeric_value") @db.Decimal(20, 6)
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)

  attribute     Attribute                       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]
  templateSelections ProductTemplateAttributeValue[]

  @@unique([attributeId, code])
  @@index([attributeId, active])
  @@map("attribute_values")
}

model ProductTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  categoryId    String      @map("category_id") @db.Uuid
  brandId       String?     @map("brand_id") @db.Uuid
  nameFa        String      @map("name_fa")
  nameEn        String?     @map("name_en")
  internalCode  String?     @map("internal_code")
  description   String?
  productType   ProductType @default(STORABLE) @map("product_type")
  isSellable    Boolean     @default(true) @map("is_sellable")
  isPurchasable Boolean     @default(true) @map("is_purchasable")
  defaultSalesUomId    String? @map("default_sales_uom_id") @db.Uuid
  defaultPurchaseUomId String? @map("default_purchase_uom_id") @db.Uuid
  defaultSalesPrice    Decimal @default(0) @map("default_sales_price") @db.Decimal(20, 4)
  defaultTaxDefinitionId String? @map("default_tax_definition_id") @db.Uuid
  active        Boolean     @default(true)
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int         @default(1)

  company        Company         @relation(fields: [companyId], references: [id])
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  brand          Brand?          @relation(fields: [brandId], references: [id])
  salesUom       Uom?            @relation("TemplateSalesUom", fields: [defaultSalesUomId], references: [id])
  purchaseUom    Uom?            @relation("TemplatePurchaseUom", fields: [defaultPurchaseUomId], references: [id])
  taxDefinition  TaxDefinition?  @relation(fields: [defaultTaxDefinitionId], references: [id])
  attributes     ProductTemplateAttribute[]
  variants       ProductVariant[]
  supplierMappings SupplierProduct[]

  @@unique([companyId, internalCode])
  @@index([companyId, nameFa])
  @@index([companyId, active])
  @@index([companyId, categoryId])
  @@index([companyId, brandId])
  @@map("product_templates")
}

// Which attributes define a template's variants; ordering + semantics flags.

model ProductTemplateAttribute {
  id              String  @id @default(uuid()) @db.Uuid
  templateId      String  @map("template_id") @db.Uuid
  attributeId     String  @map("attribute_id") @db.Uuid
  displayOrder    Int     @default(0) @map("display_order")
  createsVariants Boolean @default(true) @map("creates_variants")
  isRequired      Boolean @default(false) @map("is_required")

  template  ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  selectedValues ProductTemplateAttributeValue[]

  @@unique([templateId, attributeId])
  @@index([templateId, displayOrder])
  @@map("product_template_attributes")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  sku           String
  nameFa        String   @map("name_fa")
  nameEn        String?  @map("name_en")
  // Canonical sorted "attribute_id=attribute_value_id|..." key — DB-unique per
  // template so concurrent generation can never create a duplicate combination.
  combinationKey String  @map("combination_key")
  weightPerUnit Decimal? @map("weight_per_unit") @db.Decimal(18, 4)
  // Explicit unit for weightPerUnit (required when weightPerUnit is set);
  // must belong to the company's Weight category (service-validated).
  weightUomId   String?  @map("weight_uom_id") @db.Uuid
  defaultUomId  String?  @map("default_uom_id") @db.Uuid
  // Authoritative UOM for inventory aggregation; all normalizedQuantity
  // values are expressed in it. Same-company; controlled after movements
  // exist (service-blocked) — Integrity Gate #2.
  inventoryUomId String? @map("inventory_uom_id") @db.Uuid
  isPublic      Boolean  @default(true) @map("is_public") // website price API visibility (Phase 5 review)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)

  company    Company         @relation(fields: [companyId], references: [id])
  template   ProductTemplate @relation(fields: [templateId], references: [id])
  defaultUom Uom?            @relation(fields: [defaultUomId], references: [id])
  weightUom  Uom?            @relation("VariantWeightUom", fields: [weightUomId], references: [id])
  inventoryUom Uom?          @relation("VariantInventoryUom", fields: [inventoryUomId], references: [id])
  values     VariantAttributeValue[]
  supplierMappings SupplierProduct[]
  salesLines SalesLine[]
  purchaseLines PurchaseLine[]
  priceRequestLines PriceRequestLine[]
  dailyPrices       DailyPrice[]
  stockMovements    StockMovement[]

  @@unique([companyId, sku])
  @@unique([templateId, combinationKey])
  @@index([templateId, active])
  @@map("product_variants")
}

// Selected AttributeValues allowed for a template attribute (3B correction #2):
// the template/matrix/variant generator uses THESE, not every global value.

model ProductTemplateAttributeValue {
  id                String  @id @default(uuid()) @db.Uuid
  templateAttributeId String @map("template_attribute_id") @db.Uuid
  attributeValueId  String  @map("attribute_value_id") @db.Uuid
  displayOrder      Int     @default(0) @map("display_order")
  active            Boolean @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  templateAttribute ProductTemplateAttribute @relation(fields: [templateAttributeId], references: [id], onDelete: Cascade)
  attributeValue    AttributeValue           @relation(fields: [attributeValueId], references: [id])

  @@unique([templateAttributeId, attributeValueId])
  @@index([templateAttributeId, displayOrder])
  @@map("product_template_attribute_values")
}

// One value per attribute per variant; explicit relations (no JSON).

model VariantAttributeValue {
  id               String @id @default(uuid()) @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  attributeId      String @map("attribute_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeId])
  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

// ───────────────────── Supplier ↔ product mapping (3B) ─────────────────────
// Real FKs (Party landed in 3A; product tables above). Three-level mapping,
// exactly one target set — enforced by supplier_products_exactly_one_level_chk
// CHECK (Correction Gate migration) and again in the service.

enum SupplierMappingLevel {
  VARIANT
  TEMPLATE
  CATEGORY
}

model SupplierProduct {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  supplierPartyId   String              @map("supplier_party_id") @db.Uuid
  mappingLevel      SupplierMappingLevel @map("mapping_level")
  productVariantId  String?             @map("product_variant_id") @db.Uuid
  productTemplateId String?             @map("product_template_id") @db.Uuid
  categoryId        String?             @map("category_id") @db.Uuid
  supplierProductCode String?           @map("supplier_product_code")
  supplierProductName String?           @map("supplier_product_name")
  notes             String?
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id])
  supplierParty   Party            @relation(fields: [supplierPartyId], references: [id])
  productVariant  ProductVariant?  @relation(fields: [productVariantId], references: [id])
  productTemplate ProductTemplate? @relation(fields: [productTemplateId], references: [id])
  category        ProductCategory? @relation(fields: [categoryId], references: [id])

  @@index([companyId, supplierPartyId])
  @@index([productVariantId])
  @@index([productTemplateId])
  @@index([categoryId])
  @@map("supplier_products")
}

// ─────────────── CRM funnel: Lead → Opportunity ───────────────
// A returning customer gets a NEW Opportunity per buying intent; the Party
// master never changes (REQUIREMENTS §8).

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  partyId       String?    @map("party_id") @db.Uuid
  name          String
  phone         String?
  source        String?
  campaign      String?
  media         String?
  referrer      String?
  assignedSalespersonId String? @map("assigned_salesperson_id") @db.Uuid
  status        LeadStatus @default(NEW)
  notes         String?
  createdBy     String?    @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int        @default(1)

  company Company @relation(fields: [companyId], references: [id])
  party   Party?  @relation(fields: [partyId], references: [id])
  salesperson User? @relation("LeadSalesperson", fields: [assignedSalespersonId], references: [id])

  @@index([companyId, status])
  @@index([companyId, assignedSalespersonId])
  @@map("leads")
}

enum OpportunityStatus {
  OPEN
  QUALIFIED
  QUOTED
  WON
  LOST
}

model Opportunity {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  customerPartyId  String            @map("customer_party_id") @db.Uuid
  salespersonUserId String           @map("salesperson_user_id") @db.Uuid
  title            String
  description      String?
  estimatedAmount  Decimal?          @map("estimated_amount") @db.Decimal(20, 4)
  estimatedTonnage Decimal?          @map("estimated_tonnage") @db.Decimal(18, 4)
  status           OpportunityStatus @default(OPEN)
  source           String?
  lostReasonId     String?           @map("lost_reason_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int               @default(1)

  company    Company     @relation(fields: [companyId], references: [id])
  customer   Party       @relation("OpportunityCustomer", fields: [customerPartyId], references: [id])
  salesperson User       @relation("OpportunitySalesperson", fields: [salespersonUserId], references: [id])
  lostReason LostReason? @relation(fields: [lostReasonId], references: [id])
  priceRequests PriceRequest[]
  salesDocuments SalesDocument[]

  @@index([companyId, customerPartyId, status])
  @@index([companyId, salespersonUserId, status])
  @@map("opportunities")
}

// Configurable lost reasons (reportable; never a hard-coded string).
model LostReason {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  nameFa    String   @map("name_fa")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company       @relation(fields: [companyId], references: [id])
  opportunities Opportunity[]
  salesDocuments SalesDocument[]

  @@unique([companyId, code])
  @@map("lost_reasons")
}

// Configurable payment terms (basic Phase 4 structure; accounting consumes later).
model PaymentTerm {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String
  nameFa      String   @map("name_fa")
  nameEn      String?  @map("name_en")
  description String?
  daysOffset  Int?     @map("days_offset")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company          Company          @relation(fields: [companyId], references: [id])
  salesDocuments   SalesDocument[]
  purchaseDocuments PurchaseDocument[]

  @@unique([companyId, code])
  @@map("payment_terms")
}

// ─────────── Sales: ONE entity for quotation → sales order ───────────
// NON-NEGOTIABLE: Quotation and SalesOrder share ONE id and ONE
// document_number; the number is never regenerated (REQUIREMENTS §9).

enum SalesDocumentStatus {
  DRAFT
  QUOTATION
  SENT
  CUSTOMER_CONFIRMED
  SALES_ORDER
  PARTIALLY_LOADED
  COMPLETED
  CANCELLED
  LOST
}

model SalesDocument {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  documentNumber String             @map("document_number")
  opportunityId  String?            @map("opportunity_id") @db.Uuid
  customerPartyId String            @map("customer_party_id") @db.Uuid
  salespersonUserId String         @map("salesperson_user_id") @db.Uuid
  documentDate   DateTime           @map("document_date") @db.Timestamptz(6)
  expirationDate DateTime?          @map("expiration_date") @db.Timestamptz(6)
  currency       String             @default("IRR")
  paymentTermId  String?            @map("payment_term_id") @db.Uuid
  shippingAddressId String?         @map("shipping_address_id") @db.Uuid
  language       String             @default("fa")
  quotationTemplateCode String?     @map("quotation_template_code")
  priceRequestId String?            @map("price_request_id") @db.Uuid // reference only, not required
  status         SalesDocumentStatus @default(DRAFT)
  subtotal       Decimal            @default(0) @db.Decimal(20, 4)
  discountTotal  Decimal            @default(0) @map("discount_total") @db.Decimal(20, 4)
  taxTotal       Decimal            @default(0) @map("tax_total") @db.Decimal(20, 4)
  total          Decimal            @default(0) @db.Decimal(20, 4)
  operationalOrderedAmount Decimal?  @map("operational_ordered_amount") @db.Decimal(20, 4)
  operationalLoadedAmount  Decimal?  @map("operational_loaded_amount") @db.Decimal(20, 4)
  notes          String?
  lostReasonId   String?            @map("lost_reason_id") @db.Uuid
  version        Int                @default(1)
  createdBy      String?            @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  customer     Party        @relation("SalesCustomer", fields: [customerPartyId], references: [id])
  salesperson  User         @relation("SalesSalesperson", fields: [salespersonUserId], references: [id])
  paymentTerm  PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  shippingAddress Address?  @relation(fields: [shippingAddressId], references: [id])
  lostReason   LostReason?  @relation(fields: [lostReasonId], references: [id])
  priceRequest PriceRequest? @relation(fields: [priceRequestId], references: [id])
  lines        SalesLine[]

  @@unique([companyId, documentNumber])
  @@index([companyId, status, documentDate])
  @@index([companyId, customerPartyId])
  @@index([companyId, salespersonUserId, status])
  @@map("sales_documents")
}

model SalesLine {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  salesDocumentId      String   @map("sales_document_id") @db.Uuid
  productVariantId     String   @map("product_variant_id") @db.Uuid
  printableDescription String?  @map("printable_description")
  orderedQuantity      Decimal  @map("ordered_quantity") @db.Decimal(18, 4)
  uomId                String   @map("uom_id") @db.Uuid
  unitPrice            Decimal  @map("unit_price") @db.Decimal(20, 4) // snapshot at document time — DailyPrice changes never touch it
  priceSource          String?  @map("price_source") // MANUAL | DAILY_PRICE | TEMPLATE_DEFAULT
  priceDate            DateTime? @map("price_date") @db.Date // reference to the DailyPrice day when applicable
  discountAmount       Decimal  @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxDefinitionId      String?  @map("tax_definition_id") @db.Uuid
  taxRateSnapshot      Decimal? @map("tax_rate_snapshot") @db.Decimal(9, 4)
  subtotal             Decimal  @db.Decimal(20, 4)
  taxAmount            Decimal  @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal            Decimal  @map("line_total") @db.Decimal(20, 4)
  notes                String?
  lineOrder            Int      @default(0) @map("line_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  document      SalesDocument  @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  uom           Uom            @relation(fields: [uomId], references: [id])
  taxDefinition TaxDefinition? @relation(fields: [taxDefinitionId], references: [id])
  salesAllocations SalesPurchaseAllocation[]
  loadingAllocations LoadingAllocation[]

  @@index([salesDocumentId])
  @@index([productVariantId])
  @@map("sales_lines")
}

// ───────────────── Purchase (independent, no PriceRequest required) ─────────────────

enum PurchaseDocumentStatus {
  DRAFT
  ORDER_PLACED
  PARTIALLY_LOADED
  COMPLETED
  CANCELLED
}

model PurchaseDocument {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  documentNumber String                @map("document_number")
  supplierPartyId String               @map("supplier_party_id") @db.Uuid
  buyerUserId    String                @map("buyer_user_id") @db.Uuid
  documentDate   DateTime              @map("document_date") @db.Timestamptz(6)
  currency       String                @default("IRR")
  paymentTermId  String?               @map("payment_term_id") @db.Uuid
  priceRequestId String?               @map("price_request_id") @db.Uuid // reference only
  status         PurchaseDocumentStatus @default(DRAFT)
  subtotal       Decimal               @default(0) @db.Decimal(20, 4)
  discountTotal  Decimal               @default(0) @map("discount_total") @db.Decimal(20, 4)
  taxTotal       Decimal               @default(0) @map("tax_total") @db.Decimal(20, 4)
  total          Decimal               @default(0) @db.Decimal(20, 4)
  operationalOrderedAmount Decimal?    @map("operational_ordered_amount") @db.Decimal(20, 4)
  operationalLoadedAmount  Decimal?    @map("operational_loaded_amount") @db.Decimal(20, 4)
  notes          String?
  version        Int                   @default(1)
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id])
  supplier     Party        @relation("PurchaseSupplier", fields: [supplierPartyId], references: [id])
  buyer        User         @relation("PurchaseBuyer", fields: [buyerUserId], references: [id])
  paymentTerm  PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  priceRequest PriceRequest? @relation(fields: [priceRequestId], references: [id])
  lines        PurchaseLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, documentNumber])
  @@index([companyId, status, documentDate])
  @@index([companyId, supplierPartyId])
  @@map("purchase_documents")
}

model PurchaseLine {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  purchaseDocumentId String   @map("purchase_document_id") @db.Uuid
  productVariantId   String   @map("product_variant_id") @db.Uuid
  orderedQuantity    Decimal  @map("ordered_quantity") @db.Decimal(18, 4)
  uomId              String   @map("uom_id") @db.Uuid
  unitPrice          Decimal  @map("unit_price") @db.Decimal(20, 4) // snapshot at document time
  priceSource        String?  @map("price_source") // MANUAL | TEMPLATE_DEFAULT (purchase daily prices optional)
  priceDate          DateTime? @map("price_date") @db.Date
  lineTotal          Decimal  @map("line_total") @db.Decimal(20, 4)
  notes              String?
  lineOrder          Int      @default(0) @map("line_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  document      PurchaseDocument @relation(fields: [purchaseDocumentId], references: [id], onDelete: Cascade)
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id])
  uom           Uom              @relation(fields: [uomId], references: [id])
  purchaseAllocations SalesPurchaseAllocation[]
  loadingAllocations LoadingAllocation[]
  goodsReceiptLines GoodsReceiptLine[]
  fulfillments      PurchaseLineFulfillment[]

  @@index([purchaseDocumentId])
  @@index([productVariantId])
  @@map("purchase_lines")
}

// Line-level M:N supply allocation; over-allocation prevented with
// transaction + row locks (service).
// Purchase fulfillment ledger (final correction #1): GoodsReceipt receipts and
// direct Loading allocations are SEPARATE contribution rows (never overwrite
// each other). Quantities recorded in the purchase line's own UOM so
// received/directLoaded/fulfilled sum directly.
enum PurchaseFulfillmentType {
  GOODS_RECEIPT
  DIRECT_LOADING
}

model PurchaseLineFulfillment {
  id            String                 @id @default(uuid()) @db.Uuid
  companyId     String                 @map("company_id") @db.Uuid
  purchaseLineId String                @map("purchase_line_id") @db.Uuid
  type          PurchaseFulfillmentType
  sourceId      String                 @map("source_id") @db.Uuid // goodsReceiptId | loadingId
  quantity      Decimal                @db.Decimal(18, 4) // in purchaseLine.uomId
  uomId         String                 @map("uom_id") @db.Uuid // purchaseLine uom
  amount        Decimal?               @db.Decimal(20, 4) // quantity × line.unitPrice snapshot
  reversedAt    DateTime?              @map("reversed_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  uom          Uom          @relation(fields: [uomId], references: [id])

  @@unique([purchaseLineId, type, sourceId])
  @@index([purchaseLineId])
  @@map("purchase_line_fulfillments")
}

model SalesPurchaseAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  salesLineId       String   @map("sales_line_id") @db.Uuid
  purchaseLineId    String   @map("purchase_line_id") @db.Uuid
  allocatedQuantity Decimal  @map("allocated_quantity") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid

  company      Company      @relation(fields: [companyId], references: [id])
  salesLine    SalesLine    @relation(fields: [salesLineId], references: [id])
  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id])

  @@unique([salesLineId, purchaseLineId])
  @@index([salesLineId])
  @@index([purchaseLineId])
  @@map("sales_purchase_allocations")
}

// ─────────── Price requests + supplier offers (independent, optional) ───────────

enum PriceRequestStatus {
  OPEN
  OFFERED
  CONVERTED
  CLOSED
}

model PriceRequest {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  requestNumber    String             @map("request_number")
  requesterUserId  String             @map("requester_user_id") @db.Uuid
  customerPartyId  String?            @map("customer_party_id") @db.Uuid
  opportunityId    String?            @map("opportunity_id") @db.Uuid
  requestDate      DateTime           @map("request_date") @db.Timestamptz(6)
  status           PriceRequestStatus @default(OPEN)
  notes            String?
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company             @relation(fields: [companyId], references: [id])
  requester      User                @relation("PriceRequester", fields: [requesterUserId], references: [id])
  customer       Party?              @relation("PriceRequestCustomer", fields: [customerPartyId], references: [id])
  opportunity    Opportunity?        @relation(fields: [opportunityId], references: [id])
  lines          PriceRequestLine[]
  salesDocuments SalesDocument[]
  purchaseDocuments PurchaseDocument[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status, requestDate])
  @@map("price_requests")
}

model PriceRequestLine {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  priceRequestId    String   @map("price_request_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  uomId             String   @map("uom_id") @db.Uuid
  notes             String?
  lineOrder         Int      @default(0) @map("line_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  priceRequest PriceRequest    @relation(fields: [priceRequestId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  uom          Uom             @relation(fields: [uomId], references: [id])
  offers       SupplierOffer[]

  @@index([priceRequestId])
  @@index([productVariantId])
  @@map("price_request_lines")
}

model SupplierOffer {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  priceRequestLineId String  @map("price_request_line_id") @db.Uuid
  supplierPartyId   String   @map("supplier_party_id") @db.Uuid
  offeredPrice      Decimal  @map("offered_price") @db.Decimal(20, 4)
  uomId             String   @map("uom_id") @db.Uuid
  paymentTerms      String?
  deliveryTime      String?  @map("delivery_time")
  notes             String?
  offeredAt         DateTime @default(now()) @map("offered_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company          Company          @relation(fields: [companyId], references: [id])
  priceRequestLine PriceRequestLine @relation(fields: [priceRequestLineId], references: [id], onDelete: Cascade)
  supplier         Party            @relation("OfferSupplier", fields: [supplierPartyId], references: [id])
  uom              Uom              @relation(fields: [uomId], references: [id])

  @@index([priceRequestLineId])
  @@index([companyId, supplierPartyId, offeredAt])
  @@map("supplier_offers")
}

// ───────────── Document Flow (navigation layer, complements FKs) ─────────────

enum DocumentRelationType {
  CREATED_FROM
  GENERATED_FROM
  RELATED
  BASED_ON
}

model DocumentRelation {
  id           String               @id @default(uuid()) @db.Uuid
  companyId    String               @map("company_id") @db.Uuid
  fromType     String               @map("from_type")
  fromId       String               @map("from_id") @db.Uuid
  toType       String               @map("to_type")
  toId         String               @map("to_id") @db.Uuid
  relationType DocumentRelationType @default(RELATED) @map("relation_type")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?              @map("created_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@unique([fromType, fromId, toType, toId, relationType])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@map("document_relations")
}

// ─────────────── Phase 5: Daily Pricing + Publishing Engine ───────────────
// Price is DAILY — never averaged. History is append/audit based: one row per
// (variant, date, uom); edits of TODAY are allowed and audited old/new;
// previous days are immutable (REQUIREMENTS §17, §7 tax-rate-style rule).

enum DailyPriceSource {
  MANUAL
  SUPPLIER_OFFER
  IMPORTED
  API
}

model DailyPrice {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  productVariantId String           @map("product_variant_id") @db.Uuid
  date             DateTime         @db.Date
  price            Decimal          @db.Decimal(20, 4)
  uomId            String           @map("uom_id") @db.Uuid
  supplierPartyId  String?          @map("supplier_party_id") @db.Uuid // optional: cheapest supplier of the day
  source           DailyPriceSource @default(MANUAL)
  notes            String?
  enteredBy        String?          @map("entered_by") @db.Uuid
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company        @relation(fields: [companyId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  uom       Uom            @relation(fields: [uomId], references: [id])
  supplier  Party?         @relation("PricedAsSupplier", fields: [supplierPartyId], references: [id])

  @@unique([companyId, productVariantId, date, uomId])
  @@index([companyId, date])
  @@index([productVariantId, date])
  @@map("daily_prices")
}

// ─────────────── Publishing: batch → per-channel queue items ───────────────
// Every external communication goes through the central queue (BullMQ/Redis
// runtime + QueueJob history). A batch fans out one item per channel;
// each item carries attempt count, provider response and error for the
// admin queue dashboard.

enum PublishChannel {
  WEBSITE
  TELEGRAM
  WHATSAPP
  EITAA
  BALE
  RUBIKA
  SMS
}

enum PublishBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum PublishItemStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

model PublishBatch {
  id         String            @id @default(uuid()) @db.Uuid
  companyId  String            @map("company_id") @db.Uuid
  batchNumber String           @map("batch_number")
  priceDate  DateTime          @map("price_date") @db.Date
  status     PublishBatchStatus @default(PENDING)
  notes      String?
  createdBy  String?           @map("created_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt DateTime?         @map("finished_at") @db.Timestamptz(6)

  company Company           @relation(fields: [companyId], references: [id])
  items   PublishBatchItem[]

  @@unique([companyId, batchNumber])
  @@index([companyId, status, createdAt])
  @@map("publish_batches")
}

model PublishBatchItem {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  batchId          String            @map("batch_id") @db.Uuid
  channel          PublishChannel
  destination      String? // channel id / chat id / webhook target
  templateId       String?           @map("template_id") @db.Uuid
  renderedPayload  Json?             @map("rendered_payload")
  status           PublishItemStatus @default(PENDING)
  attemptCount     Int               @default(0) @map("attempt_count")
  maxAttempts      Int               @default(5) @map("max_attempts")
  lastError        String?           @map("last_error")
  providerResponse Json?             @map("provider_response")
  queuedJobId      String?           @map("queued_job_id") @db.Uuid
  priceDate        DateTime          @map("price_date") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?         @map("finished_at") @db.Timestamptz(6)

  batch   PublishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  template PublishingTemplate? @relation(fields: [templateId], references: [id])

  @@unique([batchId, channel, destination])
  @@index([companyId, status])
  @@index([queuedJobId])
  @@map("publish_batch_items")
}

// Configurable per-channel message templates with placeholders
// ({product} {size} {brand} {price} {date} {uom}).

model PublishingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  channel     PublishChannel
  code        String
  nameFa      String   @map("name_fa")
  bodyTemplate String  @map("body_template")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company            @relation(fields: [companyId], references: [id])
  items   PublishBatchItem[]

  @@unique([companyId, channel, code])
  @@map("publishing_templates")
}

// ─────────────── Automation foundation (IF condition THEN action) ───────────────
// Lean Phase 5 subset of REQUIREMENTS §52: triggers the pricing/publishing
// flow needs now; Workflow/Notification engines stay the executors where used.

enum AutomationTriggerType {
  PRICE_UPDATED
  CUSTOMER_INACTIVE_DAYS
  QUOTATION_PENDING_DAYS
  MANUAL
}

enum AutomationActionType {
  PUBLISH_PRICE
  SEND_SMS
  CREATE_ACTIVITY
  CREATE_NOTIFICATION
}

model AutomationRule {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  code           String
  nameFa         String                @map("name_fa")
  triggerType    AutomationTriggerType @map("trigger_type")
  triggerConfig  Json                  @map("trigger_config") // {channels:[...], days:N, ...}
  conditionConfig Json?                @map("condition_config") // reuse notification-conditions evaluator
  actionType     AutomationActionType  @map("action_type")
  actionConfig   Json                  @map("action_config")
  enabled        Boolean               @default(true)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company         @relation(fields: [companyId], references: [id])
  runs    AutomationRun[]

  @@unique([companyId, code])
  @@index([triggerType, enabled])
  @@map("automation_rules")
}

model AutomationRun {
  id             String   @id @default(uuid()) @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  ruleVersion    Int      @map("rule_version")
  triggerPayload Json?    @map("trigger_payload")
  status         String // SUCCESS | FAILED | SKIPPED
  conditionsResult Json?  @map("conditions_result")
  error          String?
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

// ───────────────────────── Loading ─────────────────────────

// ─────────────── Phase 6: Warehouse, Stock Movements, Approvals ───────────────
// Movements are AUTO-GENERATED from operational documents (Purchase confirmed →
// IN, Loading confirmed → OUT) — no manual stock entry (boundaries doc rule 5).
// warehouse_id on every movement keeps multi-warehouse open (rule 6).

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  nameFa    String   @map("name_fa")
  nameEn    String?  @map("name_en")
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company        @relation(fields: [companyId], references: [id])
  movements StockMovement[]
  loadings  Loading[]
  locations StockLocation[]

  @@unique([companyId, code])
  @@map("warehouses")
}

enum StockLocationType {
  SUPPLIER
  INTERNAL
  CUSTOMER
  TRANSIT
}

// Location-based movement model (Integrity Gate #6): a movement goes FROM a
// location TO a location. Warehouses own one or more INTERNAL locations.
// Company physical stock = INTERNAL locations only (#7).
model StockLocation {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  type        StockLocationType
  warehouseId String?          @map("warehouse_id") @db.Uuid // INTERNAL: owning warehouse
  partyId     String?          @map("party_id") @db.Uuid // SUPPLIER/CUSTOMER party when external
  code        String
  nameFa      String           @map("name_fa")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company        @relation(fields: [companyId], references: [id])
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  party     Party?         @relation("LocationParty", fields: [partyId], references: [id])
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("stock_locations")
}

enum StockDirection {
  IN
  OUT
}

model StockMovement {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  productVariantId String        @map("product_variant_id") @db.Uuid
  // Original source quantity/UOM — preserved verbatim for audit (#1).
  sourceQuantity   Decimal       @map("source_quantity") @db.Decimal(18, 4)
  sourceUomId      String        @map("source_uom_id") @db.Uuid
  // Normalized to the variant's inventoryUom via the UOM engine (#1/#3) —
  // the ONLY column stock aggregation may ever SUM.
  normalizedQuantity Decimal    @map("normalized_quantity") @db.Decimal(18, 4)
  inventoryUomId   String       @map("inventory_uom_id") @db.Uuid
  // Location-based flow (#6): warehouseId kept for INTERNAL convenience.
  direction        StockDirection
  sourceLocationId String        @map("source_location_id") @db.Uuid
  destinationLocationId String   @map("destination_location_id") @db.Uuid
  warehouseId      String?       @map("warehouse_id") @db.Uuid
  movementDate     DateTime      @map("movement_date") @db.Timestamptz(6)
  sourceEntityType String        @map("source_entity_type") // PURCHASE_RECEIPT | LOADING | LOADING_REVERSAL | RECEIPT_REVERSAL
  sourceEntityId   String        @map("source_entity_id") @db.Uuid
  idempotencyKey   String        @unique @map("idempotency_key")
  reversalOfMovementId String?   @map("reversal_of_movement_id") @db.Uuid // compensating movement linkage
  // Valuation foundation for Accounting (final correction #3): immutable cost
  // snapshot per movement, in the variant's inventoryUom context. Rows are
  // never updated — cost history stays append-only.
  unitCostSnapshot  Decimal?      @map("unit_cost_snapshot") @db.Decimal(20, 6)
  totalCostSnapshot Decimal?      @map("total_cost_snapshot") @db.Decimal(20, 4)
  createdBy        String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company        @relation(fields: [companyId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  sourceUom      Uom            @relation("MovementSourceUom", fields: [sourceUomId], references: [id])
  inventoryUom   Uom            @relation("MovementInventoryUom", fields: [inventoryUomId], references: [id])
  sourceLocation      StockLocation @relation("MovementFrom", fields: [sourceLocationId], references: [id])
  destinationLocation StockLocation @relation("MovementTo", fields: [destinationLocationId], references: [id])
  warehouse      Warehouse?     @relation(fields: [warehouseId], references: [id])
  loading        Loading?       @relation(fields: [sourceEntityId], references: [id])

  @@index([companyId, productVariantId, movementDate])
  @@index([destinationLocationId, productVariantId])
  @@index([sourceLocationId, productVariantId])
  @@index([sourceEntityType, sourceEntityId])
  @@map("stock_movements")
}


// Real partial warehouse receipts (Integrity Gate #9): actual physical
// quantity drives stock, never the PO ordered quantity. Confirmed receipts
// are immutable — corrections go through REVERSED + compensating movements.

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  REVERSED
  CANCELLED
}

model GoodsReceipt {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  receiptNumber     String           @map("receipt_number")
  purchaseDocumentId String          @map("purchase_document_id") @db.Uuid
  destinationLocationId String       @map("destination_location_id") @db.Uuid // INTERNAL location
  receiptDate       DateTime         @map("receipt_date") @db.Timestamptz(6)
  status            GoodsReceiptStatus @default(DRAFT)
  notes             String?
  reversalOfId      String?          @map("reversal_of_id") @db.Uuid
  reversalReason    String?          @map("reversal_reason")
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseDocument PurchaseDocument @relation(fields: [purchaseDocumentId], references: [id])
  destinationLocation StockLocation @relation(fields: [destinationLocationId], references: [id])
  lines       GoodsReceiptLine[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, status, receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String  @id @default(uuid()) @db.Uuid
  goodsReceiptId  String  @map("goods_receipt_id") @db.Uuid
  purchaseLineId  String  @map("purchase_line_id") @db.Uuid
  actualQuantity  Decimal @map("actual_quantity") @db.Decimal(18, 4)
  uomId           String  @map("uom_id") @db.Uuid
  // Over-receipt snapshot as of THIS receipt's confirmation (final #2):
  // ordered (line UOM), receivedBefore + this receipt, overReceived —
  // persistent, survives recalculation-free reporting.
  orderedQuantitySnapshot  Decimal? @map("ordered_quantity_snapshot") @db.Decimal(18, 4)
  receivedQuantitySnapshot Decimal? @map("received_quantity_snapshot") @db.Decimal(18, 4)
  overReceivedSnapshot     Decimal? @map("over_received_snapshot") @db.Decimal(18, 4)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receipt      GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id])
  uom          Uom          @relation(fields: [uomId], references: [id])

  @@unique([goodsReceiptId, purchaseLineId])
  @@index([purchaseLineId])
  @@map("goods_receipt_lines")
}

// ─────────────── Lean approval engine// ─────────────── Lean approval engine (debt gate + reusable) ───────────────
// Minimal Phase 6 subset of REQUIREMENTS §51: single approver requests used by
// the Loading debt gate; sequential/multi-approver lands with Workflow (Phase 9).

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  // Fully generic entity reference (Integrity Gate #13): NO physical FK —
  // services validate existence. Loading queries by (entityType='loading').
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  approvalType String         @map("approval_type") // RELEASE_DRIVER_INFO | ...
  requestedBy String?        @map("requested_by") @db.Uuid
  approverId  String?        @map("approver_id") @db.Uuid // resolved approver (manager)
  status      ApprovalStatus @default(PENDING)
  reason      String?
  decisionNote String?       @map("decision_note")
  decidedBy   String?        @map("decided_by") @db.Uuid
  decidedAt   DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// Header + lines: one bill of lading may carry several products; each line
// records the explicit product and actual quantity. Allocations link lines
// to sales/purchase lines; a loading is registered ONCE and shown on both sides.

enum LoadingStatus {
  DRAFT
  CONFIRMED
  REVERSED
  CANCELLED
}

// Explicit physical route (Integrity Gate #10) — never inferred from the
// presence of a warehouse.
enum LoadingRoute {
  DIRECT_SUPPLIER_TO_CUSTOMER
  WAREHOUSE_TO_CUSTOMER
  SUPPLIER_TO_WAREHOUSE
}

model Loading {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  loadingDate    DateTime     @map("loading_date") @db.Timestamptz(6)
  status         LoadingStatus @default(DRAFT)
  route          LoadingRoute @default(DIRECT_SUPPLIER_TO_CUSTOMER)
  reversalOfId   String?      @map("reversal_of_id") @db.Uuid // this loading compensates that original
  reversalReason String?      @map("reversal_reason")
  // Debt gate (REQUIREMENTS §20): driver/carrier info stays hidden from
  // customer-facing surfaces while driverInfoRestricted = true.
  driverInfoRestricted Boolean @default(false) @map("driver_info_restricted")
  warehouseId    String?      @map("warehouse_id") @db.Uuid // null = company default warehouse
  customerPartyId String?     @map("customer_party_id") @db.Uuid // customer-facing side (debt gate + portal)
  driverPartyId  String?      @map("driver_party_id") @db.Uuid
  carrierPartyId String?      @map("carrier_party_id") @db.Uuid
  notes          String?
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company       @relation(fields: [companyId], references: [id])
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id])
  reversalOf Loading?   @relation("LoadingReversalOf", fields: [reversalOfId], references: [id])
  reversals  Loading[]  @relation("LoadingReversalOf")
  customer Party?       @relation("LoadingCustomer", fields: [customerPartyId], references: [id])
  driver  Party?        @relation("LoadingDriver", fields: [driverPartyId], references: [id])
  carrier Party?        @relation("LoadingCarrier", fields: [carrierPartyId], references: [id])
  lines   LoadingLine[]
  movements StockMovement[]

  @@index([companyId, loadingDate])
  @@index([companyId, status])
  @@index([customerPartyId])
  @@map("loadings")
}

model LoadingLine {
  id              String  @id @default(uuid()) @db.Uuid
  loadingId       String  @map("loading_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid // Phase 3 FK
  actualQuantity  Decimal @map("actual_quantity") @db.Decimal(18, 4)
  uomId           String? @map("uom_id") @db.Uuid // Phase 3 FK
  notes           String?

  loading Loading           @relation(fields: [loadingId], references: [id], onDelete: Cascade)
  allocations LoadingAllocation[]

  @@index([loadingId])
  @@map("loading_lines")
}

model LoadingAllocation {
  id                String  @id @default(uuid()) @db.Uuid
  companyId         String  @map("company_id") @db.Uuid
  loadingLineId     String  @map("loading_line_id") @db.Uuid
  salesLineId       String? @map("sales_line_id") @db.Uuid
  purchaseLineId    String? @map("purchase_line_id") @db.Uuid
  allocatedQuantity Decimal @map("allocated_quantity") @db.Decimal(18, 4)

  loadingLine LoadingLine @relation(fields: [loadingLineId], references: [id], onDelete: Cascade)
  salesLine   SalesLine?   @relation(fields: [salesLineId], references: [id])
  purchaseLine PurchaseLine? @relation(fields: [purchaseLineId], references: [id])

  @@index([loadingLineId])
  @@index([salesLineId])
  @@index([purchaseLineId])
  @@map("loading_allocations")
}

// ───────────────────── Accounting foundation ─────────────────────

model ChartOfAccount {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  type      AccountType
  parentId  String? @map("parent_id") @db.Uuid

  company  Company          @relation(fields: [companyId], references: [id])
  parent   ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountTree")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

model JournalEntry {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  entryNumber    String             @map("entry_number")
  entryDate      DateTime           @map("entry_date") @db.Timestamptz(6)
  journalCode    String             @default("GENERAL") @map("journal_code")
  documentType   String?            @map("document_type") // BANK_TRANSFER | RECEIPT | PAYMENT | CHECK_CLEAR ...
  description    String?
  status         JournalEntryStatus @default(DRAFT)
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(6)
  reversedByEntryId String?         @map("reversed_by_entry_id") @db.Uuid
  version        Int                @default(1)
  createdBy      String?            @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company       @relation(fields: [companyId], references: [id])
  lines      JournalLine[]
  statementLines BankStatementLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, entryDate])
  @@map("journal_entries")
}

// Invariants enforced in DB (migration CHECKs) and in JournalService:
//   debit >= 0, credit >= 0, never both positive on one line,
//   SUM(debit) == SUM(credit) enforced inside the POST transaction,
//   posted entries are never edited/deleted — corrected via REVERSED.
model JournalLine {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  partyId        String? @map("party_id") @db.Uuid // subsidiary ledger detail; Phase 3 FK
  description    String?
  debit          Decimal @default(0) @db.Decimal(20, 4)
  credit         Decimal @default(0) @db.Decimal(20, 4)

  entry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String
  bankName      String   @map("bank_name")
  accountNumber String?  @map("account_number")
  iban          String?
  currency      String   @default("IRR")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company             @relation(fields: [companyId], references: [id])
  statementLines BankStatementLine[]
  receipts       Receipt[]
  payments       Payment[]
  sourceTransfers      BankTransfer[] @relation("TransferSource")
  destinationTransfers BankTransfer[] @relation("TransferDestination")
  checks         Check[]

  @@index([companyId])
  @@map("bank_accounts")
}

// NOT a source of accounting truth. Ledger/ordering projection of treasury
// documents (Receipt, Payment, BankTransfer, Check clearing, Bank Adjustment):
// deterministic daily ordering + running balance + reconciliation links.
enum BankLineDirection {
  DEPOSIT
  WITHDRAWAL
}

model BankStatementLine {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  bankAccountId   String            @map("bank_account_id") @db.Uuid
  entryDate       DateTime          @map("entry_date") @db.Date
  sequenceNo      Int               @map("sequence_no")
  direction       BankLineDirection
  amount          Decimal           @db.Decimal(20, 4)
  runningBalance  Decimal           @map("running_balance") @db.Decimal(20, 4)
  referenceNumber String?           @map("reference_number")
  description     String?
  sourceEntityType String?          @map("source_entity_type") // RECEIPT | PAYMENT | BANK_TRANSFER | CHECK
  sourceEntityId  String?           @map("source_entity_id") @db.Uuid
  journalEntryId  String?           @map("journal_entry_id") @db.Uuid
  isReconciled    Boolean           @default(false) @map("is_reconciled")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  bankAccount BankAccount    @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([companyId, bankAccountId, entryDate, sequenceNo])
  @@index([bankAccountId, entryDate])
  @@map("bank_statement_lines")
}

model Receipt {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  receiptNumber  String   @map("receipt_number")
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  partyId        String?  @map("party_id") @db.Uuid // Phase 3 FK
  amount         Decimal  @db.Decimal(20, 4)
  receiptDate    DateTime @map("receipt_date") @db.Timestamptz(6)
  description    String?
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  settlementClaimId String? @map("settlement_claim_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([companyId, receiptNumber])
  @@map("receipts")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  paymentNumber  String   @map("payment_number")
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  partyId        String?  @map("party_id") @db.Uuid // Phase 3 FK
  amount         Decimal  @db.Decimal(20, 4)
  paymentDate    DateTime @map("payment_date") @db.Timestamptz(6)
  description    String?
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  settlementClaimId String? @map("settlement_claim_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([companyId, paymentNumber])
  @@map("payments")
}

// Transfer X with fee F:
//   Dr Destination Bank X, Dr Bank Fee Expense F, Cr Source Bank X+F
//   Statement lines: source WITHDRAWAL X+F, destination DEPOSIT X.
model BankTransfer {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  transferNumber          String   @map("transfer_number")
  sourceBankAccountId     String   @map("source_bank_account_id") @db.Uuid
  destinationBankAccountId String  @map("destination_bank_account_id") @db.Uuid
  amount                  Decimal  @db.Decimal(20, 4)
  fee                     Decimal  @default(0) @db.Decimal(20, 4)
  transferDate            DateTime @map("transfer_date") @db.Timestamptz(6)
  description             String?
  journalEntryId          String?  @map("journal_entry_id") @db.Uuid
  createdBy               String?  @map("created_by") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceBankAccount      BankAccount @relation("TransferSource", fields: [sourceBankAccountId], references: [id])
  destinationBankAccount BankAccount @relation("TransferDestination", fields: [destinationBankAccountId], references: [id])
  company                Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, transferNumber])
  @@map("bank_transfers")
}

// Bank effect happens ONLY on Incoming CLEARED / Outgoing PAID.
enum CheckDirection {
  INCOMING
  OUTGOING
}

enum CheckStatus {
  REGISTERED
  PENDING
  DEPOSITED
  CLEARED // incoming only
  PAID // outgoing only
  BOUNCED
  CANCELLED
}

model Check {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  direction      CheckDirection
  checkNumber    String        @map("check_number")
  bankName       String?       @map("bank_name")
  partyId        String?       @map("party_id") @db.Uuid // Phase 3 FK
  amount         Decimal       @db.Decimal(20, 4)
  issueDate      DateTime?     @map("issue_date") @db.Timestamptz(6)
  dueDate        DateTime      @map("due_date") @db.Timestamptz(6)
  status         CheckStatus   @default(REGISTERED)
  bankAccountId  String?       @map("bank_account_id") @db.Uuid // required before CLEARED/PAID
  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  description    String?
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([companyId, status, dueDate])
  @@map("checks")
}

// ───────────────────── Customer portal ─────────────────────
// verified_mobile is used ONLY for initial linking; after linking, lookups go
// through portalAccountId. Ambiguous mobile → nothing exposed automatically.

enum PortalAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model PortalAccount {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  partyId        String             @map("party_id") @db.Uuid // Phase 3 FK
  websiteUserId  String?            @map("website_user_id")
  verifiedMobile String             @map("verified_mobile")
  status         PortalAccountStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, verifiedMobile])
  // Mini-Gate #3: one website user may link to at most one Party per company.
  // Partial unique index (non-null website_user_id) added in migration:
  //   portal_accounts_website_user_uniq
  @@index([partyId])
  @@map("portal_accounts")
}
