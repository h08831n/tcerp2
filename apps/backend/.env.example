# ── Backend ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Development database. Integration tests NEVER run against this —
# `npm run test:integration` defaults to the dedicated test database
# `tcerp_test`. Running tests against `tcerp` requires an explicit
# TCERP_INTEGRATION_ALLOW_DEV_DB=1 opt-in (enforced by src/testing/db-guard.ts).
# Moadian tax authority integration (Phase 8) — mock is the default; NEVER
# enable sandbox/live without authorized Sharjh credentials
# MOADIAN_MODE=mock
# MOADIAN_BASE_URL=https://tp.tax.gov.ir/requestsmanager/api/v2
# MOADIAN_FISCAL_ID=
# MOADIAN_ECONOMIC_CODE=
# MOADIAN_CLIENT_ID=
# MOADIAN_PRIVATE_KEY=          # PEM, newlines escaped as 

# MOADIAN_CERTIFICATE=          # PEM, newlines escaped as 

DATABASE_URL=postgresql://tcerp:tcerp@localhost:5433/tcerp?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed credentials (no default password — in production a strong value is
# REQUIRED; well-known defaults like Admin@12345/password/123456 refuse to boot)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_COMPANY_NAME=شرکت پیش‌فرض

# Queue runtime driver: auto (bullmq → fallback db) | bullmq | db
QUEUE_DRIVER=auto

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO (file storage) ────────────────────────────
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=tcerpminio
S3_SECRET_KEY=tcerpminio123
S3_BUCKET=tcerp-files
S3_FORCE_PATH_STYLE=true

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
